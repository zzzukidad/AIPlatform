# Dragon Gas & Plumbing — environment configuration
# Copy to .env and adjust. Everything here is optional.

# Port the server listens on
PORT=3000

# Bind address (0.0.0.0 exposes to the network — use behind a reverse proxy)
HOST=0.0.0.0

# Set to production to enable static asset caching + HSTS
NODE_ENV=development

# Set to true when serving over HTTPS (enables HSTS + Secure cookies)
COOKIE_SECURE=false
